{
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "Bash(python src/*)",
      "Bash(python skill/hfss-agent/verify_skill.py*)",
      "Bash(python workspaces/*)",
      "Bash(rg *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"${CLAUDE_PROJECT_DIR}/scripts/hook_log.py\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"${CLAUDE_PROJECT_DIR}/scripts/hook_log.py\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"${CLAUDE_PROJECT_DIR}/scripts/hook_log.py\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
