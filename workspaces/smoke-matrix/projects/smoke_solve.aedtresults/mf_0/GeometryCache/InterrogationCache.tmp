$begin 'InterrogationCache'
	Version=1
	$begin 'ValidationStatus'
		$begin 'Options'
			EntityCheckLevel='Strict'
			IgnoreUnclassifiedObjects=false
			SkipIntersectionChecks=false
		$end 'Options'
		Status=true
	$end 'ValidationStatus'
	$begin 'BodyCaches'
		$begin '6'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: 0, 0, 0]
				High[3: 10, 8, 2]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '6'
		$begin '34'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -15.000000000000002, -15, -15.000000000000002]
				High[3: 25, 23, 18]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '34'
	$end 'BodyCaches'
	$begin 'IntersectionCaches'
	$end 'IntersectionCaches'
$end 'InterrogationCache'
